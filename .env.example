# Server-side Gemini configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Paymob checkout configuration (server-side only; never expose these in the frontend)
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-paymob-integration-id
PAYMOB_IFRAME_ID=your-paymob-iframe-id
# sandbox or live
PAYMOB_MODE=sandbox
# true keeps checkout as a safe placeholder and makes no Paymob API calls
PAYMOB_DRY_RUN=true
# Optional override for a Paymob-compatible test endpoint
PAYMOB_BASE_URL=https://accept.paymob.com/api
